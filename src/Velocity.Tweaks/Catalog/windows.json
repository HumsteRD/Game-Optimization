[
  {
    "Id": "win.gamedvr_off",
    "Category": "Windows",
    "Title": "Отключить фоновую запись Game DVR",
    "Description": "Xbox Game Bar постоянно держит в памяти буфер записи последних минут игры. Это стоит кадров даже тогда, когда ты ничего не записываешь и не собираешься.",
    "Effect": "Фоновая запись отключена",
    "ExpectedGain": "Обычно +2–6% FPS и меньше просадок 1% low",
    "Risk": "Safe",
    "Confidence": "Measured",
    "Presets": ["Safe", "Gaming", "Competitive", "Maximum", "Extreme", "Laptop"],
    "Detect": { "type": "registry", "Hive": "HKCU", "Path": "System\\GameConfigStore", "Name": "GameDVR_Enabled", "Expected": "0" },
    "Apply": [
      { "type": "registry", "Hive": "HKCU", "Path": "System\\GameConfigStore", "Name": "GameDVR_Enabled", "Kind": "dword", "Value": "0" },
      { "type": "registry", "Hive": "HKCU", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR", "Name": "AppCaptureEnabled", "Kind": "dword", "Value": "0" }
    ]
  },
