<UserControl x:Class="Velocity.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="{StaticResource BgBase}">

    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,16">
            <StackPanel>
                <TextBlock Text="Точки отката" Style="{StaticResource TextTitle}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource TextBody}" Margin="0,12,0,0" FontSize="{StaticResource FontSm}"
                           MaxWidth="640" HorizontalAlignment="Stretch"
                           Text="Перед каждым применением состояние системы сохраняется целиком. Откат возвращает значения ровно такими, какими они были — включая те, которых вообще не существовало до изменения."/>
            </StackPanel>
            <Button x:Name="RefreshButton" Content="Обновить" Style="{StaticResource ButtonGhost}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,24">
            <StackPanel>
                <ItemsControl x:Name="SnapshotList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding When}" Style="{StaticResource TextBase}"
                                                       FontWeight="SemiBold"/>
                                            <Border Background="{StaticResource BgElevated}" CornerRadius="3"
                                                    Padding="6,2" Margin="10,0,0,0"
                                                    Visibility="{Binding IsReverted, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="ОТКАЧЕНО" Style="{StaticResource TextLabel}"
                                                           Foreground="{StaticResource TextTertiary}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource TextMuted}"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextBody}"
                                                   Margin="0,8,0,0" FontSize="{StaticResource FontSm}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Откатить" Style="{StaticResource ButtonDanger}"
                                            VerticalAlignment="Top" Tag="{Binding Id}" Click="Revert_Click"
                                            IsEnabled="{Binding CanRevert}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="20,18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Точек отката пока нет" Style="{StaticResource TextBase}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource TextBody}" Margin="0,6,0,0"
                                   Text="Они появятся автоматически, как только применишь первую настройку. Ничего создавать вручную не нужно."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
