<UserControl x:Class="Velocity.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="{StaticResource BgBase}">

    <UserControl.Resources>
        <app:NullToVisibilityConverter x:Key="NullToVis"/>
        <app:CountToVisibilityConverter x:Key="CountToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="Профили игр" Style="{StaticResource TextTitle}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource TextBody}" Margin="0,12,0,0" FontSize="{StaticResource FontSm}"
                       Text="Движковые настройки дают больше кадров, чем любые системные твики. Здесь собрано то, что относится к конкретной игре: параметры запуска, правки конфигов и настройки, которые надо выставить в самой игре."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,24">
            <StackPanel>
                <ItemsControl x:Name="GameList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,17">
                                <StackPanel>

                                    <!-- Заголовок игры -->
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextBase}"
                                                       FontSize="{StaticResource FontLg}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Location}" Style="{StaticResource TextMuted}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Content="Применить профиль" Style="{StaticResource ButtonSecondary}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Tag="{Binding Id}" Click="ApplyProfile_Click"/>
                                    </Grid>

                                    <!-- Параметры запуска -->
                                    <StackPanel Margin="0,16,0,0"
                                                Visibility="{Binding LaunchOptions, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="ПАРАМЕТРЫ ЗАПУСКА" Style="{StaticResource TextLabel}"/>
                                        <Border Background="{StaticResource BgInset}" CornerRadius="{StaticResource RadiusSm}"
                                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                                Padding="10,7" Margin="0,6,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding LaunchOptions}" Style="{StaticResource TextValue}"
                                                           Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                                                           Margin="0,0,70,0"/>
                                                <Button Content="Копировать" Style="{StaticResource ButtonGhost}"
                                                        FontSize="{StaticResource FontXs}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Tag="{Binding LaunchOptions}" Click="Copy_Click"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding LaunchOptionsWhy}" Style="{StaticResource TextMuted}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Настройки внутри игры -->
                                    <StackPanel Margin="0,16,0,0"
                                                Visibility="{Binding Settings.Count, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="ВЫСТАВИТЬ В НАСТРОЙКАХ ИГРЫ" Style="{StaticResource TextLabel}"/>
                                        <ItemsControl ItemsSource="{Binding Settings}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Точка-индикатор важности вместо цветной плашки:
                                                             не перетягивает внимание с текста. -->
                                                        <Ellipse Grid.Column="0" Width="5" Height="5"
                                                                 VerticalAlignment="Top" Margin="0,7,10,0"
                                                                 Fill="{Binding ImpactBrush}"/>

                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Style="{StaticResource TextBase}"
                                                                           FontSize="{StaticResource FontSm}"/>
                                                                <TextBlock Text="→" Style="{StaticResource TextMuted}"
                                                                           Margin="7,0"/>
                                                                <TextBlock Text="{Binding Value}"
                                                                           Style="{StaticResource TextBase}"
                                                                           FontSize="{StaticResource FontSm}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Accent}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Why}" Style="{StaticResource TextMuted}"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Замечания -->
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding Notes.Count, Converter={StaticResource CountToVis}}">
                                        <ItemsControl ItemsSource="{Binding Notes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InfoDim}" Padding="11,8"
                                                            CornerRadius="{StaticResource RadiusSm}" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding}" Style="{StaticResource TextMuted}"
                                                                   Foreground="{StaticResource Info}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="20,18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Игр с готовым профилем не найдено" Style="{StaticResource TextBase}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource TextBody}" Margin="0,6,0,0"
                                   Text="Программа ищет игры в библиотеках Steam, Epic Games и Xbox. Профили пока есть для части популярных тайтлов — список пополняется."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
