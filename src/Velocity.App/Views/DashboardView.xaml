<UserControl x:Class="Velocity.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="{StaticResource BgBase}">

    <UserControl.Resources>
        <app:SeverityBrushConverter x:Key="SeverityBrush"/>
        <app:SeverityLabelConverter x:Key="SeverityLabel"/>
        <app:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Строка «метка — значение». Основной способ подачи данных в этом интерфейсе:
             плотно, выровнено по колонке, без карточек вокруг каждого факта. -->
        <DataTemplate x:Key="SpecRow">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource TextMuted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource TextBase}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─────────── Шапка раздела ─────────── -->
        <Grid Grid.Row="0" Margin="28,24,28,18">
            <StackPanel>
                <TextBlock Text="Обзор системы" Style="{StaticResource TextTitle}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,4,0,0"
                           Text="Сканирование…"/>
            </StackPanel>
            <Button x:Name="RescanButton" Style="{StaticResource ButtonSecondary}"
                    Content="Пересканировать" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Rescan_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,24">
            <StackPanel>

                <!-- ─────────── Оценка и конфигурация ─────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="ОЦЕНКА СИСТЕМЫ" Style="{StaticResource TextLabel}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock x:Name="ScoreValue" Text="—" Style="{StaticResource TextMetric}"
                                           FontSize="{StaticResource Font3xl}" FontWeight="SemiBold"/>
                                <TextBlock Text="/100" Style="{StaticResource TextMuted}"
                                           VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                            </StackPanel>

                            <!-- Шкала: тонкая полоса вместо кругового индикатора.
                                 Кольцо занимает много места и хуже читается боковым зрением. -->
                            <Border Height="4" Background="{StaticResource BgInset}" CornerRadius="2"
                                    Margin="0,10,0,0">
                                <Border x:Name="ScoreBar" HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource Accent}" CornerRadius="2"/>
                            </Border>

                            <TextBlock x:Name="ScoreLabel" Text="" Margin="0,10,0,0"
                                       Style="{StaticResource TextBase}" FontWeight="SemiBold"/>

                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="ProblemCount" Text="—" Style="{StaticResource TextMetric}"
                                               FontSize="{StaticResource FontXl}"/>
                                    <TextBlock Text="проблем" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="FixableCount" Text="—" Style="{StaticResource TextMetric}"
                                               FontSize="{StaticResource FontXl}" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="исправим сами" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="КОНФИГУРАЦИЯ" Style="{StaticResource TextLabel}" Margin="0,0,0,14"/>
                            <ItemsControl x:Name="SpecList" ItemTemplate="{StaticResource SpecRow}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─────────── Находки ─────────── -->

                <TextBlock x:Name="FindingsHeader" Text="НАЙДЕННЫЕ ПРОБЛЕМЫ"
                           Style="{StaticResource TextLabel}" Margin="2,26,0,10"/>

                <ItemsControl x:Name="FindingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Цветом отмечается только узкая полоса слева.
                                         Заливать карточку целиком — превратить список в светофор. -->
                                    <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Stretch" Margin="-18,-15,0,-15"
                                               Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>

                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}"
                                                       Style="{StaticResource TextLabel}"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource TextBody}"
                                                   Margin="0,6,0,0" FontSize="{StaticResource FontSm}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{Binding Recommendation, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="→" Foreground="{StaticResource Accent}"
                                                       Style="{StaticResource TextBase}" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding Recommendation}" Margin="8,0,0,0"
                                                       Style="{StaticResource TextBase}"
                                                       FontSize="{StaticResource FontSm}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource TextMuted}"
                                                   Margin="18,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding ExpectedGain, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>

                                    <!-- Находку, которую программа умеет исправить сама,
                                         нужно уметь исправить прямо отсюда. Иначе отчёт
                                         остаётся текстом, а не инструментом. -->
                                    <Button Grid.Column="2" Content="Исправить"
                                            Style="{StaticResource ButtonSecondary}"
                                            VerticalAlignment="Top" Margin="16,0,0,0"
                                            Tag="{Binding FixTweakId}" Click="Fix_Click"
                                            Visibility="{Binding FixTweakId, Converter={StaticResource NullToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="CleanState" Style="{StaticResource Card}" Padding="20,18"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Критичных проблем не найдено" Style="{StaticResource TextBase}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                        <TextBlock Text="Система настроена аккуратно. Загляни в раздел «Оптимизация» — там есть настройки, которые скан не считает проблемой, но которые всё равно стоит включить."
                                   Style="{StaticResource TextBody}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
