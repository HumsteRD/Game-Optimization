<UserControl x:Class="Velocity.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="{StaticResource BgBase}">

    <UserControl.Resources>
        <app:RiskLabelConverter x:Key="RiskLabel"/>
        <app:RiskBrushConverter x:Key="RiskBrush"/>
        <app:NullToVisibilityConverter x:Key="NullToVis"/>
        <app:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <CollectionViewSource x:Key="GroupedTweaks">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CategoryName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Пресет: обычная кнопка-переключатель без заливки.
             Активный помечается рамкой акцента, не фоном — так их проще сравнивать глазами. -->
        <Style x:Key="PresetChip" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSm}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="13,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─────────── Шапка и пресеты ─────────── -->
        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="Оптимизация" Style="{StaticResource TextTitle}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,4,0,0"/>

            <TextBlock Text="НАБОР НАСТРОЕК" Style="{StaticResource TextLabel}" Margin="0,20,0,8"/>
            <WrapPanel x:Name="PresetPanel">
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Safe"
                             Content="Безопасный" IsChecked="True" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Gaming"
                             Content="Игровой" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Competitive"
                             Content="Соревновательный" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Maximum"
                             Content="Максимум" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Extreme"
                             Content="Экстремальный" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="All"
                             Content="Все настройки" Checked="Preset_Checked"/>
            </WrapPanel>

            <TextBlock x:Name="PresetHint" Style="{StaticResource TextBody}" Margin="0,10,0,0"
                       FontSize="{StaticResource FontSm}"/>
        </StackPanel>

        <!-- ─────────── Список твиков ─────────── -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,16">
            <ItemsControl x:Name="TweakList" ItemsSource="{Binding Source={StaticResource GroupedTweaks}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextLabel}"
                                           Margin="2,18,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" Style="{StaticResource TextBody}"
                                               Margin="0,6,0,0" FontSize="{StaticResource FontSm}"/>

                                    <!-- Метаданные одной строкой: риск, состояние, эффект, перезагрузка.
                                         Вынесены вниз, чтобы не соперничать с названием за внимание. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Risk, Converter={StaticResource RiskLabel}}"
                                                   Style="{StaticResource TextMuted}"
                                                   Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}"/>
                                        <TextBlock Text="·" Style="{StaticResource TextMuted}" Margin="7,0"/>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource TextMuted}"/>
                                        <TextBlock Text="·" Style="{StaticResource TextMuted}" Margin="7,0"
                                                   Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="нужна перезагрузка" Style="{StaticResource TextMuted}"
                                                   Foreground="{StaticResource Warning}"
                                                   Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource TextMuted}"
                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}"
                                               Visibility="{Binding ExpectedGain, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanApply}"
                                          VerticalAlignment="Top" Margin="0,3,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ─────────── Панель действий ─────────── -->
        <Border Grid.Row="2" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionText" Style="{StaticResource TextBase}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectionHint" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SelectAllButton" Style="{StaticResource ButtonGhost}"
                            Content="Выбрать всё" Click="SelectAll_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource ButtonPrimary}"
                            Content="Применить" Click="Apply_Click" MinWidth="130"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
