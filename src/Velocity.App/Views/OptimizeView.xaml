<UserControl x:Class="Velocity.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="{StaticResource BgBase}">

    <UserControl.Resources>
        <app:RiskLabelConverter x:Key="RiskLabel"/>
        <app:RiskBrushConverter x:Key="RiskBrush"/>
        <app:NullToVisibilityConverter x:Key="NullToVis"/>
        <app:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <app:CountToVisibilityConverter x:Key="CountToVis"/>

        <CollectionViewSource x:Key="GroupedTweaks">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CategoryName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="PresetChip" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSm}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="13,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Метка раздела внутри раскрытой справки -->
        <Style x:Key="GuideLabel" TargetType="TextBlock" BasedOn="{StaticResource TextLabel}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="Оптимизация" Style="{StaticResource TextTitle}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,4,0,0"/>

            <TextBlock Text="НАБОР НАСТРОЕК" Style="{StaticResource TextLabel}" Margin="0,20,0,8"/>
            <WrapPanel x:Name="PresetPanel">
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Safe"
                             Content="Безопасный" IsChecked="True" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Gaming"
                             Content="Игровой" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Competitive"
                             Content="Соревновательный" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Maximum"
                             Content="Максимум" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="Extreme"
                             Content="Экстремальный" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset" Tag="All"
                             Content="Все настройки" Checked="Preset_Checked"/>
            </WrapPanel>

            <TextBlock x:Name="PresetHint" Style="{StaticResource TextBody}" Margin="0,10,0,0"
                       FontSize="{StaticResource FontSm}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,16">
            <ItemsControl x:Name="TweakList" ItemsSource="{Binding Source={StaticResource GroupedTweaks}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextLabel}"
                                           Margin="2,18,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                            <StackPanel>

                                <!-- ─── Свёрнутая строка: название, короткий эффект, действие ─── -->
                                <Grid Background="Transparent" MouseLeftButtonUp="Row_Click"
                                      Cursor="Hand" Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Headline}" Style="{StaticResource TextMuted}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Состояние. Вместо погашенного переключателя без объяснений
                                         показываем словами, что именно с этой настройкой. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Visibility="{Binding ShowDoneMark, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="{StaticResource Success}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="применено" Style="{StaticResource TextMuted}"
                                                   Foreground="{StaticResource Success}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{StaticResource WarningDim}"
                                            CornerRadius="3" Padding="7,3" Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ShowManualMark, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ВРУЧНУЮ" Style="{StaticResource TextLabel}"
                                                   Foreground="{StaticResource Warning}"/>
                                    </Border>

                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Visibility="{Binding ShowToggle, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Стрелка раскрытия -->
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" Text="&#xE70D;">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="&#xE70E;"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- ─── Раскрытая справка ─── -->
                                <StackPanel Margin="18,0,18,16"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                                    <TextBlock Text="ЧТО ЭТО" Style="{StaticResource GuideLabel}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource TextBody}"
                                               FontSize="{StaticResource FontSm}"/>

                                    <TextBlock Text="ЧТО ИЗМЕНИТСЯ" Style="{StaticResource GuideLabel}"
                                               Margin="0,14,0,5"
                                               Visibility="{Binding Effect, Converter={StaticResource NullToVis}}"/>
                                    <TextBlock Text="{Binding Effect}" Style="{StaticResource TextValue}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Effect, Converter={StaticResource NullToVis}}"/>

                                    <!-- Пошаговая инструкция для того, что программа сделать не может -->
                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ManualSteps.Count, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="КАК ЭТО СДЕЛАТЬ" Style="{StaticResource GuideLabel}"/>
                                        <ItemsControl ItemsSource="{Binding ManualSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="5" Height="5" CornerRadius="3"
                                                                Background="{StaticResource Accent}"
                                                                VerticalAlignment="Top" Margin="2,7,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}"
                                                                   Style="{StaticResource TextBody}"
                                                                   FontSize="{StaticResource FontSm}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Text="НАСКОЛЬКО ЭТО НАДЁЖНО" Style="{StaticResource GuideLabel}"
                                               Margin="0,14,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Fill="{Binding Risk, Converter={StaticResource RiskBrush}}"/>
                                        <TextBlock Text="{Binding RiskText}" Style="{StaticResource TextBody}"
                                                   FontSize="{StaticResource FontSm}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource TextMuted}"
                                               Margin="13,4,0,0" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="13,4,0,0"
                                                Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Вступит в силу после перезагрузки"
                                                   Style="{StaticResource TextMuted}"
                                                   Foreground="{StaticResource Warning}"/>
                                    </StackPanel>

                                    <TextBlock Text="Нужны права администратора" Style="{StaticResource TextMuted}"
                                               Margin="13,4,0,0"
                                               Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Почему переключателя нет -->
                                    <Border Background="{StaticResource BgInset}" CornerRadius="{StaticResource RadiusSm}"
                                            Padding="11,9" Margin="0,14,0,0"
                                            Visibility="{Binding DisabledReason, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource TextMuted}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionText" Style="{StaticResource TextBase}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectionHint" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SelectAllButton" Style="{StaticResource ButtonGhost}"
                            Content="Выбрать всё" Click="SelectAll_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource ButtonPrimary}"
                            Content="Применить" Click="Apply_Click" MinWidth="130"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
