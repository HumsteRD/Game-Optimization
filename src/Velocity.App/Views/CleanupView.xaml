<UserControl x:Class="Velocity.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="{StaticResource BgBase}">

    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <app:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,16">
            <StackPanel>
                <TextBlock Text="Очистка диска" Style="{StaticResource TextTitle}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,4,0,0"
                           Text="Нажми «Сканировать», чтобы посмотреть, чем занято место"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox x:Name="DriveSelector" Width="80" Margin="0,0,8,0" VerticalContentAlignment="Center"
                          SelectionChanged="Drive_Changed"/>
                <Button x:Name="ScanButton" Style="{StaticResource ButtonSecondary}"
                        Content="Сканировать" Click="Scan_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,20">
            <StackPanel>

                <!-- ─────────── Чем занято место ─────────── -->
                <Border x:Name="UsagePanel" Style="{StaticResource Card}" Padding="20,18" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="ЧЕМ ЗАНЯТО МЕСТО" Style="{StaticResource TextLabel}"/>
                            <TextBlock x:Name="UsageSummary" Style="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Полосчатая диаграмма: сегменты в одну строку читаются быстрее круга
                             и не требуют легенды с процентами по кругу. -->
                        <Border CornerRadius="4" Height="26" ClipToBounds="True"
                                Background="{StaticResource BgInset}">
                            <ItemsControl x:Name="UsageBar">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid x:Name="BarHost"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>

                        <ItemsControl x:Name="UsageLegend" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2"
                                                Background="{Binding Color}" VerticalAlignment="Center"
                                                Margin="0,0,11,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextBase}"
                                                       FontSize="{StaticResource FontSm}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource TextMuted}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Hint, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   Style="{StaticResource TextValue}" VerticalAlignment="Center"
                                                   Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PercentText}"
                                                   Style="{StaticResource TextMuted}" VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ─────────── Что можно удалить ─────────── -->
                <TextBlock x:Name="JunkHeader" Text="ЧТО МОЖНО УДАЛИТЬ" Style="{StaticResource TextLabel}"
                           Margin="2,24,0,10" Visibility="Collapsed"/>

                <ItemsControl x:Name="JunkList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Background="Transparent" Cursor="Hand" Margin="18,14"
                                          MouseLeftButtonUp="Row_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource Switch}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Background="{Binding SafetyBackground}" CornerRadius="3"
                                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SafetyLabel}"
                                                               Style="{StaticResource TextLabel}"
                                                               Foreground="{Binding SafetyBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LocationSummary}" Style="{StaticResource TextMuted}"
                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   Style="{StaticResource TextBase}" FontFamily="{StaticResource FontMono}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource TextTertiary}" Text="&#xE70D;">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="&#xE70E;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel Margin="18,0,18,16"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                                        <TextBlock Text="ЧТО ЭТО" Style="{StaticResource TextLabel}" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource TextBody}"
                                                   FontSize="{StaticResource FontSm}"/>

                                        <TextBlock Text="ЧТО БУДЕТ ПОСЛЕ УДАЛЕНИЯ" Style="{StaticResource TextLabel}"
                                                   Margin="0,14,0,5"/>
                                        <TextBlock Text="{Binding Consequence}" Style="{StaticResource TextBody}"
                                                   FontSize="{StaticResource FontSm}"/>

                                        <TextBlock Text="ГДЕ ЭТО ЛЕЖИТ" Style="{StaticResource TextLabel}"
                                                   Margin="0,14,0,5"/>
                                        <ItemsControl ItemsSource="{Binding Locations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource TextValue}"
                                                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="20,18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Мусора не найдено" Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Success}"/>
                        <TextBlock Style="{StaticResource TextBody}" Margin="0,6,0,0"
                                   Text="Временные файлы, кэши драйверов и остатки обновлений либо отсутствуют, либо занимают незначительное место."/>
                    </StackPanel>
                </Border>

                <Border x:Name="HintPanel" Style="{StaticResource Card}" Padding="20,18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ЧТО ПРОГРАММА НЕ УДАЛЯЕТ" Style="{StaticResource TextLabel}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource TextBody}" FontSize="{StaticResource FontSm}"
                                   Text="Никаких личных файлов, документов, сохранений игр и паролей. Список путей закрытый и составлен вручную — программа не ищет «ненужные файлы» по своему усмотрению и не пользуется масками вроде «удалить всё из папки»."/>
                        <TextBlock Style="{StaticResource TextBody}" FontSize="{StaticResource FontSm}" Margin="0,10,0,0"
                                   Text="Точки восстановления Windows и теневые копии тоже не трогаются: это страховка системы, а не мусор."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionText" Style="{StaticResource TextBase}" FontWeight="SemiBold"
                               Text="Ничего не выбрано"/>
                    <TextBlock x:Name="SelectionHint" Style="{StaticResource TextMuted}" Margin="0,2,0,0"
                               Text="Удаление необратимо — точки отката на файлы не распространяются"/>
                </StackPanel>

                <Button x:Name="CleanButton" Style="{StaticResource ButtonPrimary}"
                        Content="Удалить выбранное" Click="Clean_Click" MinWidth="170"
                        HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
