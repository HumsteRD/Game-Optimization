<UserControl x:Class="Velocity.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBase}">

    <UserControl.Resources>
        <DataTemplate x:Key="InfoRow">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource TextMuted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource TextValue}"
                           TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="Настройки" Style="{StaticResource TextTitle}"/>
            <TextBlock Text="Сведения о программе и её данных" Style="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,24">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="ПРОГРАММА" Style="{StaticResource TextLabel}" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="AboutList" ItemTemplate="{StaticResource InfoRow}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ДАННЫЕ" Style="{StaticResource TextLabel}" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="DataList" ItemTemplate="{StaticResource InfoRow}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Открыть папку данных" Style="{StaticResource ButtonSecondary}"
                                    Click="OpenDataFolder_Click"/>
                            <Button Content="Сохранить отчёт о системе" Style="{StaticResource ButtonSecondary}"
                                    Margin="8,0,0,0" Click="ExportReport_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ЧЕГО ЭТА ПРОГРАММА НЕ ДЕЛАЕТ" Style="{StaticResource TextLabel}"
                                   Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource TextBody}" FontSize="{StaticResource FontSm}"
                                   Text="Не внедряется в процессы игр и не читает их память. Не устанавливает драйверы в ядро. Не отключает Защитник Windows. Не «чистит» оперативную память и не удаляет системные службы. Не обещает прирост, который не измерен."/>
                        <TextBlock Style="{StaticResource TextBody}" FontSize="{StaticResource FontSm}" Margin="0,10,0,0"
                                   Text="Всё это — осознанные ограничения, а не недоработки. Такой набор запретов делает программу безопасной для античитов: ни Vanguard, ни EAC, ни BattlEye не к чему придраться."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ЗАГРУЖЕННЫЙ КАТАЛОГ" Style="{StaticResource TextLabel}" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="CatalogList" ItemTemplate="{StaticResource InfoRow}"/>
                        <ItemsControl x:Name="ErrorList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource TextMuted}"
                                               Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
