<Window x:Class="Velocity.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VELOCITY" Height="760" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Собственная рамка окна: стандартная рамка Windows со светлым заголовком
         рядом с тёмным интерфейсом выглядит инородно. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────── Заголовок окна ─────────── -->

            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BgBase}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <!-- Знак: две скошенные полосы. Не иконка-картинка — векторная форма
                             остаётся резкой на любом масштабе экрана. -->
                        <Canvas Width="15" Height="14" VerticalAlignment="Center">
                            <Path Fill="{StaticResource Accent}" Data="M 0,0 L 5,0 L 9,14 L 4,14 Z"/>
                            <Path Fill="{StaticResource Accent}" Opacity="0.45" Data="M 7,0 L 12,0 L 16,14 L 11,14 Z"/>
                        </Canvas>
                        <TextBlock Text="VELOCITY" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontDisplay}" FontSize="13"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="AdminBadge" Text="АДМИНИСТРАТОР" Margin="12,1,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource TextLabel}"
                                   Foreground="{StaticResource TextTertiary}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE922;" Click="Maximize_Click"/>
                        <Button Style="{StaticResource CaptionButtonClose}" Content="&#xE8BB;" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─────────── Навигация ─────────── -->

            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgBase}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="16,8"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                     Content="Настройки" GroupName="Nav" Tag="Settings"
                                     Checked="Nav_Checked"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="СИСТЕМА" Style="{StaticResource TextLabel}" Margin="20,4,0,6"/>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}"
                                     Content="Обзор" GroupName="Nav" Tag="Dashboard"
                                     IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}"
                                     Content="Оптимизация" GroupName="Nav" Tag="Optimize"
                                     Checked="Nav_Checked"/>

                        <TextBlock Text="ИГРЫ" Style="{StaticResource TextLabel}" Margin="20,18,0,6"/>
                        <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}"
                                     Content="Профили игр" GroupName="Nav" Tag="Games"
                                     Checked="Nav_Checked"/>

                        <TextBlock Text="БЕЗОПАСНОСТЬ" Style="{StaticResource TextLabel}" Margin="20,18,0,6"/>
                        <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}"
                                     Content="Точки отката" GroupName="Nav" Tag="Restore"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ─────────── Содержимое ─────────── -->

            <ContentControl x:Name="ContentHost" Grid.Row="1" Grid.Column="1"/>

            <!-- ─────────── Строка состояния ─────────── -->

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource BgInset}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Style="{StaticResource TextMuted}" Text="Готов"/>
                    <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource TextMuted}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
