<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Палитра построена на одном принципе: глубина создаётся фоном и волосяной
        границей, а не тенями и градиентами. Акцент один и появляется только там,
        где есть действие или активное состояние — если подсветить им всё,
        он перестаёт что-либо значить.
    -->

    <!-- Поверхности -->
    <Color x:Key="BgBaseColor">#0B0C0F</Color>
    <Color x:Key="BgSurfaceColor">#121419</Color>
    <Color x:Key="BgElevatedColor">#181B22</Color>
    <Color x:Key="BgInsetColor">#08090B</Color>
    <Color x:Key="BgHoverColor">#1C2029</Color>

    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="BgInset" Color="{StaticResource BgInsetColor}"/>
    <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}"/>

    <!-- Границы: волосяные, почти незаметные. Их задача — разделять, а не рисовать рамки. -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#1E222B"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#2B313D"/>
    <SolidColorBrush x:Key="BorderAccent" Color="#1F4E45"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8A93A4"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#5A6373"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#3B424E"/>

    <!-- Акцент -->
    <Color x:Key="AccentColor">#28E0B0</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="#45F0C4"/>
    <SolidColorBrush x:Key="AccentDim" Color="#14342E"/>
    <SolidColorBrush x:Key="AccentText" Color="#04120E"/>

    <!-- Семантика -->
    <SolidColorBrush x:Key="Critical" Color="#F2555F"/>
    <SolidColorBrush x:Key="CriticalDim" Color="#2D1419"/>
    <SolidColorBrush x:Key="Warning" Color="#E8A33D"/>
    <SolidColorBrush x:Key="WarningDim" Color="#2B2113"/>
    <SolidColorBrush x:Key="Info" Color="#5B9BE8"/>
    <SolidColorBrush x:Key="InfoDim" Color="#141F2D"/>
    <SolidColorBrush x:Key="Success" Color="#3FCF8E"/>

    <!-- Типографика -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, JetBrains Mono, monospace</FontFamily>

    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontMd">13</sys:Double>
    <sys:Double x:Key="FontLg">15</sys:Double>
    <sys:Double x:Key="FontXl">19</sys:Double>
    <sys:Double x:Key="Font2xl">26</sys:Double>
    <sys:Double x:Key="Font3xl">42</sys:Double>

    <!-- Радиусы: сдержанные. Скруглять всё подряд — верный способ получить игрушечный вид. -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">5</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>

    <Duration x:Key="DurationFast">0:0:0.12</Duration>
    <Duration x:Key="DurationBase">0:0:0.2</Duration>

</ResourceDictionary>
